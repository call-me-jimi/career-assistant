  "cards": [
    {
      "dot": "cyan",
      "title": "Every gate is an interrupt()",
      "items": [
        "The graph parks at interrupt() and SessionRunner waits for your answer over the WebSocket",
        "On resume LangGraph re-runs the node body, so an emit_message before the interrupt needs key=",
        "File and DB writes belong after the last interrupt, or they replay too"
      ]
    },
    {
      "dot": "amber",
      "title": "Ask before you write",
      "items": [
        "log_application asks for notes and whether you sent it, before export_node writes anything",
        "Both answers fill the spreadsheet row; Status and Submission say Draft until you confirm",
        "Answering no leaves applied_at unset, so the journey stays a draft"
      ]
    },
    {
      "dot": "violet",
      "title": "Loops and resumption",
      "items": [
        "cl_review routes back into itself until the verdict is done, then the Q&A menu runs",
        "select_journey reads state.phase and re-enters at collect_job, research, strategy or cl_loop",
        "post_export returns to the Q&A menu; only the final pass synthesises a playbook lesson"
      ]
    }
  ]
