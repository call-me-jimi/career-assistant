  "cards": [
    {
      "dot": "cyan",
      "title": "One process, four graphs",
      "items": [
        "FastAPI, the runners and all four LangGraphs live in a single uvicorn process",
        "SessionRunner holds one background asyncio task per session, keyed by RunnerRegistry",
        "Cover letter, interview prep, evaluator and advisor share one ApplicationState class"
      ]
    },
    {
      "dot": "amber",
      "title": "Interrupts drive the UI",
      "items": [
        "A node calls interrupt(); the runner parks and the event goes out over /ws/{session_id}",
        "Your answer returns on the same socket and re-enters the graph through submit_input",
        "PATCH /api/sessions/{id}/state answers 409 while the runner is still running"
      ]
    },
    {
      "dot": "violet",
      "title": "Everything lands in SQLite",
      "items": [
        "The checkpointer stores each node's state so a session resumes exactly at its interrupt",
        "Storage modules keep profiles, journeys, interviews, feedback, traces and the playbook",
        "Every LLM call is traced and priced, which is what the usage dashboard reads"
      ]
    }
  ]
